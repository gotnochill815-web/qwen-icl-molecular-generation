{
  "project": "qwen_icl_molecular_generation",
  "experiment_name": "sas",
  "seed": 42,
  "target_seed_offset": 2,
  "dataset": {
    "train": "outputs/processed/guacamol_full/train.csv",
    "validation": "outputs/processed/guacamol_full/val.csv",
    "properties": [
      "logp",
      "tpsa",
      "sas",
      "qed"
    ]
  },
  "model": {
    "model_id": "Qwen/Qwen3.8-27B",
    "trust_remote_code": true,
    "dtype": "bfloat16",
    "device_map": "auto",
    "local_files_only": false,
    "auto_model_class": "AutoModelForImageTextToText"
  },
  "experiments": {
    "sas": [
      "sas"
    ]
  },
  "targets": {
    "targets_per_experiment": 3,
    "single_property_quantiles": [
      0.2,
      0.4,
      0.6,
      0.8
    ],
    "multi_property_selection": "joint_validation_rows",
    "fixed_targets": {
      "sas": [
        2.0,
        3.0,
        4.0
      ]
    }
  },
  "generation": {
    "shots": 0,
    "replicates_per_target": 1,
    "generations_per_replicate": 25,
    "temperature": 0.7,
    "top_p": 0.95,
    "max_new_tokens": 128,
    "do_sample": true,
    "repetition_penalty": 1.0,
    "generations_per_replicate_by_target": [
      34,
      33,
      33
    ]
  },
  "evaluation": {
    "tolerances": {
      "logp": 0.5,
      "tpsa": 10.0,
      "sas": 0.5,
      "qed": 0.05
    }
  },
  "paths": {
    "target_manifest": "manifests/sas_zero_shot_targets.json",
    "job_manifest": "manifests/sas_zero_shot_jobs.jsonl",
    "generation_output": "outputs/raw/sas_zero_shot.jsonl",
    "smoke_output": "outputs/raw/sas_smoke_test.jsonl"
  }
}
